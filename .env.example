# Copy to .env and fill in what you have. Only ANTHROPIC_API_KEY is needed for Claude-written scripts.

# --- Script writing (Claude) ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
# low | medium | high  (higher = better scripts, slower/more tokens)
CLAUDE_EFFORT=medium

# --- Voice-over ---
# auto = ElevenLabs if key set, else free Microsoft Edge neural voices, else offline espeak
TTS_ENGINE=auto
ELEVENLABS_API_KEY=

# --- Visuals ---
# auto | ai (AI images in the niche art style) | stock (Pexels/Pixabay footage) | local | procedural
VISUAL_SOURCE=auto
PEXELS_API_KEY=
PIXABAY_API_KEY=
# Folder with your own images/videos (filenames are matched against scene keywords)
LOCAL_MEDIA_DIR=

# --- Rendering ---
OUTPUT_DIR=output
# x264 preset: veryfast (quickest) ... fast (default) ... medium/slow (smaller files, slower)
X264_PRESET=fast
VIDEO_CRF=18
VIDEO_FPS=30
# videos rendered in parallel by the web app
WORKERS=2
